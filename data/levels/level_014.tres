[gd_resource type="Resource" script_class="LevelData" load_steps=25 format=3]

[ext_resource type="Script" path="res://resources/level_data.gd" id="1_level_data"]
[ext_resource type="Resource" path="res://data/buildings/source_data.tres" id="2_source_data"]
[ext_resource type="Resource" path="res://data/buildings/adder_data.tres" id="3_adder_data"]
[ext_resource type="Resource" path="res://data/buildings/output_data.tres" id="4_output_data"]
[ext_resource type="Resource" path="res://data/buildings/conveyor_data.tres" id="5_conveyor_data"]
[ext_resource type="Script" path="res://resources/level_building_data.gd" id="6_level_building_data"]
[ext_resource type="Script" path="res://resources/objective_data.gd" id="7_objective_data"]
[ext_resource type="Script" path="res://resources/star_condition_data.gd" id="8_star_condition_data"]
[ext_resource type="Script" path="res://resources/level_medal_data.gd" id="9_level_medal_data"]

[sub_resource type="Resource" id="SourceA"]
script = ExtResource("6_level_building_data")
building_data = ExtResource("2_source_data")
cell = Vector2i(1, 1)
locked = true
generated_value = 7

[sub_resource type="Resource" id="SourceB"]
script = ExtResource("6_level_building_data")
building_data = ExtResource("2_source_data")
cell = Vector2i(0, 5)
locked = true
generated_value = 8

[sub_resource type="Resource" id="SourceC"]
script = ExtResource("6_level_building_data")
building_data = ExtResource("2_source_data")
cell = Vector2i(1, 9)
locked = true
generated_value = 9

[sub_resource type="Resource" id="Output"]
script = ExtResource("6_level_building_data")
building_data = ExtResource("4_output_data")
cell = Vector2i(12, 5)
locked = true
target_value = 24

[sub_resource type="Resource" id="Target"]
script = ExtResource("7_objective_data")
objective_type = 0
target_value = 24
required_count = 3

[sub_resource type="Resource" id="MachineLimit"]
script = ExtResource("7_objective_data")
objective_type = 2
is_constraint = true
max_buildings = 44

[sub_resource type="Resource" id="TimeLimit"]
script = ExtResource("7_objective_data")
objective_type = 3
is_constraint = true
max_ticks = 560

[sub_resource type="Resource" id="BudgetLimit"]
script = ExtResource("7_objective_data")
objective_type = 4
is_constraint = true
max_budget = 44

[sub_resource type="Resource" id="StarComplete"]
script = ExtResource("8_star_condition_data")
stars = 1
condition_type = 0
description = "Complete the level."

[sub_resource type="Resource" id="StarBuildings"]
script = ExtResource("8_star_condition_data")
stars = 2
condition_type = 1
limit = 21
description = "Use 21 or fewer placed buildings."

[sub_resource type="Resource" id="StarTicks"]
script = ExtResource("8_star_condition_data")
stars = 3
condition_type = 2
limit = 380
description = "Complete within 380 simulation ticks."

[sub_resource type="Resource" id="StarBudget"]
script = ExtResource("8_star_condition_data")
stars = 3
condition_type = 3
limit = 32
description = "Spend 32 or less."

[sub_resource type="Resource" id="MedalBronze"]
script = ExtResource("9_level_medal_data")
medal = 1
max_ticks = 560
max_buildings = 44
description = "Bronce: completa con 560 ticks o menos y 44 maquinas o menos."

[sub_resource type="Resource" id="MedalSilver"]
script = ExtResource("9_level_medal_data")
medal = 2
max_ticks = 470
max_buildings = 32
description = "Plata: completa con 470 ticks o menos y 32 maquinas o menos."

[sub_resource type="Resource" id="MedalGold"]
script = ExtResource("9_level_medal_data")
medal = 3
max_ticks = 380
max_buildings = 21
description = "Oro: completa con 380 ticks o menos y 21 maquinas o menos."

[resource]
script = ExtResource("1_level_data")
id = &"level_014"
display_name = "Tres caminos"
objective_text = "Produce tres paquetes de 24 combinando 7, 8 y 9."
grid_size = Vector2i(13, 10)
initial_buildings = Array[LevelBuildingData]([SubResource("SourceA"), SubResource("SourceB"), SubResource("SourceC"), SubResource("Output")])
allowed_buildings = Array[BuildingData]([ExtResource("5_conveyor_data"), ExtResource("3_adder_data")])
objectives = Array[ObjectiveData]([SubResource("Target"), SubResource("MachineLimit"), SubResource("TimeLimit"), SubResource("BudgetLimit")])
max_buildings = 44
max_ticks = 560
medal_conditions = Array[LevelMedalData]([SubResource("MedalBronze"), SubResource("MedalSilver"), SubResource("MedalGold")])
star_conditions = Array[StarConditionData]([SubResource("StarComplete"), SubResource("StarBuildings"), SubResource("StarTicks"), SubResource("StarBudget")])
