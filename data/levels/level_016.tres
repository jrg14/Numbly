[sub_resource type="Resource" id="MedalBronze"]
script = ExtResource("5_level_medal_data")
max_ticks = 900
max_buildings = 80
description = "Bronce: completa usando el sandbox de piezas."

[sub_resource type="Resource" id="MedalSilver"]
script = ExtResource("5_level_medal_data")
medal = 2
max_ticks = 650
max_buildings = 50
description = "Plata: completa con 650 ticks o menos y 50 maquinas o menos."

[sub_resource type="Resource" id="MedalGold"]
script = ExtResource("5_level_medal_data")
medal = 3
max_ticks = 420
max_buildings = 30
description = "Oro: completa con 420 ticks o menos y 30 maquinas o menos."

[resource]
script = ExtResource("2_level_data")
id = &"level_016"
display_name = "Sandbox de piezas"
objective_text = "Prueba todas las piezas y produce tres paquetes de valor 10."
grid_size = Vector2i(12, 10)
initial_buildings = Array[ExtResource("3_level_building_data")]([SubResource("LevelBuildingData_source_4"), SubResource("LevelBuildingData_source_6"), SubResource("LevelBuildingData_source_2"), SubResource("LevelBuildingData_output_10")])
allowed_buildings = Array[ExtResource("1_building_data")]([ExtResource("8_conveyor_data"), ExtResource("9_adder_data"), ExtResource("10_multiplication_data"), ExtResource("11_subtraction_data"), ExtResource("12_division_data"), ExtResource("13_modulo_data"), ExtResource("14_splitter_data"), ExtResource("15_buffer_data"), ExtResource("16_merger_data"), ExtResource("17_filter_data"), ExtResource("18_gate_data")])
objectives = Array[ExtResource("4_objective_data")]([SubResource("ObjectiveData_target_10"), SubResource("ObjectiveData_machine_limit"), SubResource("ObjectiveData_time_limit"), SubResource("ObjectiveData_budget_limit")])
max_buildings = 80
max_ticks = 900
medal_conditions = Array[ExtResource("5_level_medal_data")]([SubResource("MedalBronze"), SubResource("MedalSilver"), SubResource("MedalGold")])
