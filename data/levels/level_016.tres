[resource]
script = ExtResource("1_level_data")
id = &"level_016"
display_name = "Primera division"
objective_text = "Haz entrar 8 antes que 2 para producir 4."
grid_size = Vector2i(20, 16)
initial_buildings = Array[LevelBuildingData]([SubResource("SourceA"), SubResource("SourceB"), SubResource("Output")])
allowed_buildings = Array[BuildingData]([ExtResource("5_conveyor_data"), ExtResource("3_operation_data")])
objectives = Array[ObjectiveData]([SubResource("Target"), SubResource("MachineLimit"), SubResource("TimeLimit"), SubResource("BudgetLimit")])
